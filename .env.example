# =============================================================================
# Stash — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# This is the canonical reference for all supported configuration variables.
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# PostgreSQL connection string.
#
# LOCAL (running stash directly on your machine):
#   STASH_POSTGRES_DSN=postgres://stash:stash_dev_password@localhost:5432/stash?sslmode=disable
#
# DOCKER (default — service name "postgres" resolves inside the compose network):
STASH_POSTGRES_DSN=postgres://stash:stash_dev_password@postgres:5432/stash?sslmode=disable


# -----------------------------------------------------------------------------
# AI / MODEL BACKEND
# -----------------------------------------------------------------------------
# Use OpenAI, Ollama, or any OpenAI-compatible endpoint.
#
# Ollama (local):
#   STASH_OPENAI_API_KEY=ollama
#   STASH_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#
# OpenAI (cloud):
#   STASH_OPENAI_API_KEY=sk-...
#   STASH_OPENAI_BASE_URL=https://api.openai.com/v1
STASH_OPENAI_API_KEY=your-api-key-here
STASH_OPENAI_BASE_URL=https://api.openai.com/v1


# -----------------------------------------------------------------------------
# MODELS
# -----------------------------------------------------------------------------
# Embedding model — must match STASH_VECTOR_DIM below.
#   nomic-embed-text   (Ollama)  → dim 768
#   mxbai-embed-large  (Ollama)  → dim 1024
#   text-embedding-3-small (OpenAI) → dim 1536
#   text-embedding-3-large (OpenAI) → dim 3072
STASH_EMBEDDING_MODEL=text-embedding-3-small

# Vector dimension — must match the embedding model above.
STASH_VECTOR_DIM=1536

# Reasoning model — used for relationship extraction and synthesis.
#   Ollama:      qwen3:8b, llama3.1:8b, mistral:7b
#   OpenAI:      gpt-4o-mini, gpt-4o
#   OpenRouter:  openai/gpt-4o-mini, google/gemma-3-27b-it
STASH_REASONER_MODEL=gpt-4o-mini


# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
# HTTP address and port to listen on.
STASH_HTTP_ADDR=:8080

# Log level: debug | info | warn | error
STASH_LOG_LEVEL=info

# Log format: text | json
STASH_LOG_FORMAT=text


# -----------------------------------------------------------------------------
# DATABASE POOL
# -----------------------------------------------------------------------------
# Maximum number of open connections in the connection pool.
# Local development: 5. Production / high-concurrency: 25–50.
STASH_DB_MAX_CONNS=25

# Minimum number of idle connections kept warm.
STASH_DB_MIN_CONNS=5

# -----------------------------------------------------------------------------
# MEMORY
# -----------------------------------------------------------------------------
# Time-to-live for context windows (working memory).
# Format: 1h | 30m | 2h30m
STASH_CONTEXT_TTL=1h

# Maximum number of results returned per query.
STASH_MAX_RESULT_SIZE=10000


# -----------------------------------------------------------------------------
# CONSOLIDATION
# -----------------------------------------------------------------------------
# How many events are processed per consolidation run.
STASH_CONSOLIDATION_BATCH_SIZE=100

# Similarity threshold for clustering related events (0.0–1.0).
STASH_CONSOLIDATION_SIMILARITY_THRESHOLD=0.85

# Similarity threshold for deduplicating facts (0.0–1.0).
# Facts above this threshold are skipped as duplicates.
STASH_CONSOLIDATION_DEDUP_THRESHOLD=0.95

# Time window for event consolidation (e.g., 168h = 7 days).
STASH_CONSOLIDATION_WINDOW=168h


# -----------------------------------------------------------------------------
# MEMORY DECAY & EXPIRY
# -----------------------------------------------------------------------------
# How aggressively memory strength decays over time (0.0–1.0).
# Lower = faster forgetting.
STASH_DECAY_FACTOR=0.95

# Minimum strength threshold before a memory is considered expired (0.0–1.0).
STASH_EXPIRY_THRESHOLD=0.1


# -----------------------------------------------------------------------------
# HYPOTHESIS ENGINE
# -----------------------------------------------------------------------------
# Confidence threshold above which a hypothesis is automatically confirmed.
STASH_HYPOTHESIS_AUTO_CONFIRM_THRESHOLD=0.9

# Confidence threshold below which a hypothesis is automatically rejected.
STASH_HYPOTHESIS_AUTO_REJECT_THRESHOLD=0.1


# -----------------------------------------------------------------------------
# ADVANCED (Optional)
# -----------------------------------------------------------------------------
# Override the config file path (defaults to .env in the working directory).
# STASHCONFIG=/path/to/your/.env
